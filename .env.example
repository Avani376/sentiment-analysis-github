# SENTINEX AI backend configuration — copy to .env and adjust.
# Every value has a sane default; nothing here is required for local dev.

# --- Application ---------------------------------------------------------
SENTINEX_DEBUG=false
SENTINEX_LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------
# SQLite is the zero-install development default (file lives in backend/.runtime/,
# which is gitignored). For PostgreSQL (see docker-compose.yml):
#   SENTINEX_DATABASE_URL=postgresql+psycopg://sentinex:sentinex@localhost:5432/sentinex
# SENTINEX_DATABASE_URL=

# --- Uploads & inference --------------------------------------------------
SENTINEX_MAX_UPLOAD_MB=10
SENTINEX_BATCH_LIMIT=100

# --- Model availability ----------------------------------------------------
# DistilBERT uses the local Hugging Face cache when present (~270 MB download
# on first use otherwise). cardiffnlp downloads ~500 MB on first use — keep
# false on disk-constrained machines.
SENTINEX_ENABLE_DISTILBERT=true
SENTINEX_ENABLE_CARDIFFNLP=false

# --- Optional LLM provider (Business Insights, Milestone 7) ----------------
# Never commit real keys. If unset, insights are generated deterministically.
# SENTINEX_LLM_API_KEY=
